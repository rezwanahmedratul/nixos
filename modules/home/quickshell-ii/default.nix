{
  pkgs,
  lib,
  config,
  ...
}: let
  # Python environment matching the dependencies needed by dots-hyprland
  quickshellPython = pkgs.python3.withPackages (ps: with ps; [
    pillow
    pywayland
    psutil
    kde-material-you-colors
    materialyoucolor
    libsass
    material-color-utilities
    setproctitle
    click
    loguru
    pycairo
    pygobject3
    tqdm
    numpy
    opencv4
    google-auth
    requests
  ]);

  quickshellServiceEntrypoint = pkgs.writeShellScript "quickshell-ii-service-entrypoint" ''
    set -euo pipefail

    ${pkgs.psmisc}/bin/killall -q waybar 2>/dev/null || true
    ${pkgs.procps}/bin/pkill -x waybar 2>/dev/null || true
    ${pkgs.psmisc}/bin/killall -q swaync 2>/dev/null || true
    ${pkgs.procps}/bin/pkill -x swaync 2>/dev/null || true
    ${pkgs.procps}/bin/pkill -x noctalia 2>/dev/null || true
    ${pkgs.procps}/bin/pkill -f noctalia-shell 2>/dev/null || true
    ${pkgs.psmisc}/bin/killall -q mako 2>/dev/null || true
    ${pkgs.psmisc}/bin/killall -q dunst 2>/dev/null || true
    ${pkgs.procps}/bin/pkill -f 'quickshell -c overview' 2>/dev/null || true
    ${pkgs.coreutils}/bin/sleep 0.4

    exec qs -c ii
  '';
in {
  # Declarative configuration files
  xdg.configFile = {
    "quickshell/ii".source = ./dots/quickshell/ii;
    "matugen".source = ./dots/matugen;
    "fuzzel/fuzzel.ini".source = ./dots/fuzzel/fuzzel.ini;
    "kdeglobals".source = ./dots/kdeglobals;
    "darklyrc".source = ./dots/darklyrc;
    "dolphinrc".source = ./dots/dolphinrc;
  };

  # Icon for application launcher / branding
  xdg.dataFile."icons/illogical-impulse.svg".source = ./dots/icons/illogical-impulse.svg;

  # Python virtual environment activation shim for scripts in the rice
  home.file.".local/state/quickshell/.venv/bin/activate" = {
    text = ''
      # Declarative activation shim generated by NixOS
      export PATH="${quickshellPython}/bin:$PATH"
      export VIRTUAL_ENV="$HOME/.local/state/quickshell/.venv"
      deactivate() {
        :
      }
    '';
    executable = true;
  };

  # Systemd user service for Quickshell
  systemd.user.services.quickshell = {
    Unit = {
      Description = "Quickshell II panel and widget service";
      PartOf = ["hyprland-session.target"];
      After = ["hyprland-session.target"];
    };
    Service = {
      Type = "simple";
      ExecStart = "${quickshellServiceEntrypoint}";
      Restart = "on-failure";
      RestartSec = "1";
    };
  };

  # Activation hook to prepare state directories and generate initial theme if missing
  home.activation.ensureQuickshellState = lib.hm.dag.entryAfter ["writeBoundary"] ''
    set -eu
    GEN_DIR="$HOME/.local/state/quickshell/user/generated"
    mkdir -p "$GEN_DIR"
    mkdir -p "$HOME/.local/state/quickshell/user/generated/wallpaper"
    mkdir -p "$HOME/.local/state/quickshell/.venv/bin"
    mkdir -p "$HOME/.config/hypr/hyprland"
    mkdir -p "$HOME/.config/hypr/hyprlock"
    mkdir -p "$HOME/.config/fuzzel"
    mkdir -p "$HOME/.config/gtk-3.0"
    mkdir -p "$HOME/.config/gtk-4.0"

    # Generate initial default colors if not present
    if [ ! -f "$GEN_DIR/colors.json" ]; then
      if [ -f "$HOME/nixos/wallpapers/tree.png" ]; then
        ${pkgs.matugen}/bin/matugen image "$HOME/nixos/wallpapers/tree.png" --source-color-index 0 -m dark >/dev/null 2>&1 || true
      else
        ${pkgs.matugen}/bin/matugen color hex "#33ccff" -m dark >/dev/null 2>&1 || true
      fi
    fi

    # Set default wallpaper path if not set or set to Null
    WALLPAPER_FILE="$HOME/.local/state/quickshell/user/generated/wallpaper/path.txt"
    if [ ! -s "$WALLPAPER_FILE" ] || [ "$(cat "$WALLPAPER_FILE" 2>/dev/null)" = "Null" ]; then
      if [ -f "$HOME/nixos/wallpapers/tree.png" ]; then
        printf "%s" "$HOME/nixos/wallpapers/tree.png" > "$WALLPAPER_FILE"
      fi
    fi

    # Initialize default illogical-impulse config.json if not present
    CONFIG_FILE="$HOME/.config/illogical-impulse/config.json"
    if [ ! -f "$CONFIG_FILE" ]; then
      mkdir -p "$HOME/.config/illogical-impulse"
      cat > "$CONFIG_FILE" <<EOF
{
  "background": {
    "wallpaperPath": "${config.home.homeDirectory}/nixos/wallpapers/tree.png"
  }
}
EOF
    fi
  '';
}
